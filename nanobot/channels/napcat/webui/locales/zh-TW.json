{
  "setup": {
    "docsLabel": "開啟 NapCat 設定指南",
    "officialLabel": "開啟 NapCat 文件",
    "fields": {
      "wsUrl": {
        "label": "WebSocket 網址",
        "placeholder": "ws://127.0.0.1:3001"
      },
      "accessToken": {
        "label": "存取權杖",
        "placeholder": "選填權杖"
      },
      "groupPolicy": {
        "label": "群聊規則",
        "choices": {
          "mention": "提及回覆",
          "open": "全部訊息",
          "allowlist": "允許清單"
        }
      },
      "allowFrom": {
        "label": "私聊使用者",
        "placeholder": "QQ 號；留空僅允許已配對使用者；* 允許所有使用者"
      },
      "allowGroups": {
        "label": "允許群聊",
        "placeholder": "群號，以逗號分隔；留空不允許群聊"
      },
      "groupPolicyOverrides": {
        "label": "群聊例外（JSON）"
      },
      "welcomeNewMembers": {
        "label": "入群歡迎",
        "choices": {
          "true": "開啟",
          "false": "關閉"
        }
      },
      "maxImageBytes": {
        "label": "圖片上限（位元組）"
      },
      "groupAgent_enabled": {
        "label": "群組自主回覆",
        "choices": {
          "true": "開啟",
          "false": "關閉"
        }
      },
      "groupAgent_groups": {
        "label": "自主回覆群號"
      },
      "groupAgent_batchSeconds": {
        "label": "一般訊息視窗（秒）"
      },
      "groupAgent_directedBatchSeconds": {
        "label": "定向訊息視窗（秒）"
      }
    }
  }
}
