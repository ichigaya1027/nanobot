{
  "setup": {
    "docsLabel": "NapCat 設定ガイドを開く",
    "officialLabel": "NapCat ドキュメントを開く",
    "fields": {
      "wsUrl": {
        "label": "WebSocket URL",
        "placeholder": "ws://127.0.0.1:3001"
      },
      "accessToken": {
        "label": "アクセストークン",
        "placeholder": "アクセストークン（任意）"
      },
      "groupPolicy": {
        "label": "グループのルール",
        "choices": {
          "mention": "メンションのみ",
          "open": "全メッセージ",
          "allowlist": "許可リスト"
        }
      },
      "allowFrom": {
        "label": "許可ユーザー",
        "placeholder": "QQ ID（カンマ区切り）"
      },
      "groupPolicyOverrides": {
        "label": "グループの例外（JSON）"
      },
      "welcomeNewMembers": {
        "label": "新メンバーに挨拶",
        "choices": {
          "true": "オン",
          "false": "オフ"
        }
      },
      "maxImageBytes": {
        "label": "画像の上限（バイト）"
      },
      "groupAgent_enabled": {
        "label": "グループの自律応答",
        "choices": {
          "true": "オン",
          "false": "オフ"
        }
      },
      "groupAgent_groups": {
        "label": "自律応答するグループ"
      },
      "groupAgent_batchSeconds": {
        "label": "通常メッセージの待機時間（秒）"
      },
      "groupAgent_directedBatchSeconds": {
        "label": "宛先指定メッセージの待機時間（秒）"
      }
    }
  }
}
