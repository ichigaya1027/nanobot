{
  "setup": {
    "docsLabel": "Open NapCat setup",
    "officialLabel": "Open NapCat docs",
    "fields": {
      "wsUrl": {
        "label": "WebSocket URL",
        "placeholder": "ws://127.0.0.1:3001"
      },
      "accessToken": {
        "label": "Access token",
        "placeholder": "Optional token"
      },
      "groupPolicy": {
        "label": "Group rules",
        "choices": {
          "mention": "Mentions only",
          "open": "All messages",
          "allowlist": "Allowlist"
        }
      },
      "allowFrom": {
        "label": "Allowed users",
        "placeholder": "QQ IDs, comma separated"
      },
      "groupPolicyOverrides": {
        "label": "Group exceptions (JSON)"
      },
      "welcomeNewMembers": {
        "label": "Welcome new members",
        "choices": {
          "true": "On",
          "false": "Off"
        }
      },
      "maxImageBytes": {
        "label": "Image size limit (bytes)"
      },
      "groupAgent_enabled": {
        "label": "Autonomous group replies",
        "choices": {
          "true": "On",
          "false": "Off"
        }
      },
      "groupAgent_groups": {
        "label": "Autonomous reply groups"
      },
      "groupAgent_batchSeconds": {
        "label": "Ordinary message window (seconds)"
      },
      "groupAgent_directedBatchSeconds": {
        "label": "Directed message window (seconds)"
      }
    }
  }
}
