{
  "setup": {
    "docsLabel": "Ouvrir le guide NapCat",
    "officialLabel": "Ouvrir la documentation NapCat",
    "fields": {
      "wsUrl": {
        "label": "URL WebSocket",
        "placeholder": "ws://127.0.0.1:3001"
      },
      "accessToken": {
        "label": "Jeton d’accès",
        "placeholder": "Jeton facultatif"
      },
      "groupPolicy": {
        "label": "Règles des groupes",
        "choices": {
          "mention": "Mentions uniquement",
          "open": "Tous les messages",
          "allowlist": "Liste d’autorisation"
        }
      },
      "allowFrom": {
        "label": "Utilisateurs en privé",
        "placeholder": "ID QQ ; vide : utilisateurs appairés ; * : tous"
      },
      "allowGroups": {
        "label": "Groupes autorisés",
        "placeholder": "ID des groupes séparés par des virgules ; vide : aucun"
      },
      "groupPolicyOverrides": {
        "label": "Exceptions de groupe (JSON)"
      },
      "welcomeNewMembers": {
        "label": "Accueillir les nouveaux membres",
        "choices": {
          "true": "Activé",
          "false": "Désactivé"
        }
      },
      "maxImageBytes": {
        "label": "Limite d’image (octets)"
      },
      "groupAgent_enabled": {
        "label": "Réponses autonomes en groupe",
        "choices": {
          "true": "Activé",
          "false": "Désactivé"
        }
      },
      "groupAgent_groups": {
        "label": "Groupes avec réponses autonomes"
      },
      "groupAgent_batchSeconds": {
        "label": "Délai des messages ordinaires (secondes)"
      },
      "groupAgent_directedBatchSeconds": {
        "label": "Délai des messages directs (secondes)"
      }
    }
  }
}
