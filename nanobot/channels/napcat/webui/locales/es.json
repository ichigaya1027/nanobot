{
  "setup": {
    "docsLabel": "Abrir guía de NapCat",
    "officialLabel": "Abrir documentación de NapCat",
    "fields": {
      "wsUrl": {
        "label": "URL WebSocket",
        "placeholder": "ws://127.0.0.1:3001"
      },
      "accessToken": {
        "label": "Token de acceso",
        "placeholder": "Token opcional"
      },
      "groupPolicy": {
        "label": "Reglas de grupo",
        "choices": {
          "mention": "Solo menciones",
          "open": "Todos los mensajes",
          "allowlist": "Lista de permitidos"
        }
      },
      "allowFrom": {
        "label": "Usuarios permitidos",
        "placeholder": "ID de QQ separados por comas"
      },
      "groupPolicyOverrides": {
        "label": "Excepciones de grupo (JSON)"
      },
      "welcomeNewMembers": {
        "label": "Dar bienvenida",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      },
      "maxImageBytes": {
        "label": "Límite de imagen (bytes)"
      },
      "groupAgent_enabled": {
        "label": "Respuestas autónomas en grupos",
        "choices": {
          "true": "encendido",
          "false": "Apagado"
        }
      },
      "groupAgent_groups": {
        "label": "Grupos con respuestas autónomas"
      },
      "groupAgent_batchSeconds": {
        "label": "Espera para mensajes normales (segundos)"
      },
      "groupAgent_directedBatchSeconds": {
        "label": "Espera para mensajes dirigidos (segundos)"
      }
    }
  }
}
